[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = LibThread
  FILE_GUID                      = 5dd405b1-a51e-4755-9d04-67d5ae869f4b
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = LibThread

#
#  VALID_ARCHITECTURES           = IA32 X64
#

[Sources]
  Threads.c

[Packages]
  StdLib/StdLib.dec
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiLib
  BaseLib
  UefiRuntimeServicesTableLib
  SynchronizationLib

################################################################
#
# The Build Options, below, are only used when building the C library.
# DO NOT use them when building your application!
# Nasty things could happen if you do.
#
[BuildOptions]
   GCC:*_*_*_CC_FLAGS    = -fno-strict-overflow
